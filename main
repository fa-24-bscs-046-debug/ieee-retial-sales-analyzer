"""IEEE LGU AI/ML Cohort One - Week 3: Retail Sales Intelligence (NumPy & Pandas)."""
from pathlib import Path

import numpy as np
import pandas as pd

DATA_DIR = Path(__file__).parent / "data"


def load_and_clean(path):
    """Load raw sales CSV and handle invalid, missing and duplicate records."""
    df = pd.read_csv(path)
    log = {"Raw rows": len(df)}

    # Tidy text columns so " north" == "North"
    df["product_name"] = df["product_name"].str.strip().str.title()
    df["region"] = df["region"].str.strip().str.title()

    # Duplicate order IDs: keep the first record
    before = len(df)
    df = df.drop_duplicates(subset="order_id", keep="first")
    log["Duplicate order_id rows removed"] = before - len(df)

    # Dates: invalid ones cannot be analysed by period -> drop
    df["date"] = pd.to_datetime(df["date"], errors="coerce")
    log["Rows with invalid dates dropped"] = int(df["date"].isna().sum())
    df = df.dropna(subset=["date"])

    # Units: non-numeric ("abc"), missing or <= 0 -> drop (quantity cannot be guessed)
    df["units_sold"] = pd.to_numeric(df["units_sold"], errors="coerce")
    bad_units = df["units_sold"].isna() | (df["units_sold"] <= 0)
    log["Rows with invalid units dropped"] = int(bad_units.sum())
    df = df[~bad_units].copy()

    # Prices: negative -> invalid; missing/invalid filled with that product's median price
    df["unit_price"] = pd.to_numeric(df["unit_price"], errors="coerce")
    df.loc[df["unit_price"] <= 0, "unit_price"] = np.nan
    log["Missing/invalid prices found"] = int(df["unit_price"].isna().sum())
    df["unit_price"] = df["unit_price"].fillna(
        df.groupby("product_name")["unit_price"].transform("median"))
    still_missing = df["unit_price"].isna()
    log["Prices unrecoverable (dropped)"] = int(still_missing.sum())
    df = df[~still_missing].copy()

    log["Clean rows"] = len(df)
    return df.reset_index(drop=True), log


def add_revenue(df):
    """Revenue = units x price, computed with NumPy."""
    df["revenue"] = np.multiply(df["units_sold"].to_numpy(), df["unit_price"].to_numpy())
    return df


def business_metrics(df):
    revenue = df["revenue"].to_numpy()
    units = df["units_sold"].to_numpy()
    n_orders = df["order_id"].nunique()
    total = np.sum(revenue)
    return {"total_revenue": total, "orders": n_orders,
            "aov": total / n_orders, "total_units": int(np.sum(units))}


def filter_orders(df, region, start, end):
    """Boolean-mask filter by region and date range."""
    mask = (df["region"] == region) & df["date"].between(start, end)
    return df[mask]


def print_report(df, m):
    line = "=" * 62
    by_cat = df.groupby("category")["revenue"].sum().sort_values(ascending=False)
    by_prod = (df.groupby(["category", "product_name"])["revenue"].sum()
               .sort_values(ascending=False))
    by_region = df.groupby("region")["revenue"].sum().sort_values(ascending=False)
    best_cat, best_prod = by_prod.index[0]

    print(f"\n{line}\n{'RETAIL SALES INTELLIGENCE REPORT':^62}\n{line}")
    print(f"Total revenue       : ${m['total_revenue']:,.2f}")
    print(f"Total orders        : {m['orders']}")
    print(f"Average order value : ${m['aov']:,.2f}")
    print(f"Total units sold    : {m['total_units']}")
    print(f"Top product         : {best_prod} ({best_cat}) - ${by_prod.iloc[0]:,.2f}")

    print(f"\n{'-' * 62}\nCATEGORY RANKING\n{'-' * 62}")
    for rank, (cat, rev) in enumerate(by_cat.items(), 1):
        print(f"{rank}. {cat:<14} ${rev:>10,.2f}")

    print(f"\n{'-' * 62}\nPRODUCT RANKING\n{'-' * 62}")
    for rank, ((cat, prod), rev) in enumerate(by_prod.items(), 1):
        print(f"{rank}. {prod:<22} {cat:<12} ${rev:>9,.2f}")

    print(f"\n{'-' * 62}\nREGION BREAKDOWN\n{'-' * 62}")
    for reg, rev in by_region.items():
        share = rev / m["total_revenue"] * 100
        print(f"{reg:<8} ${rev:>10,.2f}  ({share:4.1f}%)")

    sub = filter_orders(df, "North", "2026-09-01", "2026-09-15")
    print(f"\n{'-' * 62}\nFILTER: North region, 2026-09-01 to 2026-09-15\n{'-' * 62}")
    print(f"{len(sub)} orders, revenue ${sub['revenue'].sum():,.2f}")
    top = df.nlargest(3, "revenue")[["order_id", "product_name", "region", "revenue"]]
    print(f"\nTOP 3 HIGH-VALUE ORDERS\n{top.to_string(index=False)}")


def main():
    df, log = load_and_clean(DATA_DIR / "sales.csv")
    print("=" * 62 + f"\n{'DATA CLEANING LOG':^62}\n" + "=" * 62)
    for key, value in log.items():
        print(f"{key:<42}: {value}")
    df = add_revenue(df)
    print_report(df, business_metrics(df))


if __name__ == "__main__":
    main()
